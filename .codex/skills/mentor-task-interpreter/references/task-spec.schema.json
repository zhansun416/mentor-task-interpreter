{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mentor-task-interpreter/task-spec-v0.1.schema.json",
  "title": "Mentor task specification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_title", "task_goal", "deliverables", "input_sources", "explicit_requirements", "inferences", "evidence", "constraints", "deadlines", "dependencies", "execution_order", "clarifications", "confidence"],
  "properties": {
    "task_title": {"type": "string", "minLength": 1},
    "task_goal": {"type": "string", "minLength": 1},
    "deliverables": {"type": "array", "items": {"$ref": "#/definitions/deliverable"}},
    "input_sources": {"type": "array", "items": {"$ref": "#/definitions/source"}},
    "explicit_requirements": {"type": "array", "items": {"$ref": "#/definitions/requirement"}},
    "inferences": {"type": "array", "items": {"$ref": "#/definitions/inference"}},
    "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}},
    "constraints": {"type": "array", "items": {"$ref": "#/definitions/constrained_statement"}},
    "deadlines": {"type": "array", "items": {"$ref": "#/definitions/deadline"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/definitions/dependency"}},
    "execution_order": {"type": "array", "items": {"$ref": "#/definitions/execution_step"}},
    "clarifications": {"type": "array", "items": {"$ref": "#/definitions/clarification"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string", "minLength": 1},
        "path_or_reference": {"type": "string"}, "status": {"type": "string", "enum": ["available", "missing", "unreadable"]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "description", "status", "attachments"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "type": {"type": "string", "enum": ["chat", "meeting_note", "document", "email", "link", "image", "other"]},
        "description": {"type": "string", "minLength": 1}, "path_or_reference": {"type": "string"},
        "timestamp_or_order": {"type": "string"}, "status": {"type": "string", "enum": ["available", "missing", "unreadable"]},
        "attachments": {"type": "array", "items": {"$ref": "#/definitions/attachment"}}
      }
    },
    "deliverable": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "acceptance_criteria", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "description": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["active", "superseded", "conditional", "uncertain"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/id"}}, "rationale": {"type": "string"}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "basis_evidence_ids", "impact", "confidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1}, "basis_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/id"}},
        "impact": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "locator", "content", "kind", "supports"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "source_id": {"$ref": "#/definitions/id"}, "locator": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["explicit", "context", "inferred"]},
        "supports": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "constrained_statement": {
      "type": "object", "additionalProperties": false, "required": ["statement", "evidence_ids"],
      "properties": {"statement": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}}}
    },
    "deadline": {
      "type": "object", "additionalProperties": false, "required": ["description", "original_expression", "status", "evidence_ids"],
      "properties": {"description": {"type": "string", "minLength": 1}, "original_expression": {"type": "string", "minLength": 1}, "absolute_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "status": {"type": "string", "enum": ["confirmed", "relative", "uncertain"]}, "evidence_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["description", "status"],
      "properties": {"description": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["available", "blocked", "uncertain"]}, "evidence_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}}}
    },
    "execution_step": {
      "type": "object", "additionalProperties": false, "required": ["step", "task", "evidence_ids"],
      "properties": {"step": {"type": "integer", "minimum": 1}, "task": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/id"}}}
    },
    "clarification": {
      "type": "object", "additionalProperties": false, "required": ["question", "why_it_matters"],
      "properties": {"question": {"type": "string", "minLength": 1}, "why_it_matters": {"type": "string", "minLength": 1}, "related_evidence_ids": {"type": "array", "items": {"$ref": "#/definitions/id"}}}
    }
  }
}
